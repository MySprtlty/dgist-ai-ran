+/* ICNL 11/11: an integer RAN parameter by ID anywhere in the message (elements, structures, lists) */
+static bool ccma_rc_find_int(const seq_ran_param_t* p, size_t n, uint32_t id, int64_t* out, int depth)
+{
+  if (p == NULL || depth > 8)
+    return false;
+  for (size_t i = 0; i < n; i++) {
+    const ran_param_val_type_t* v = &p[i].ran_param_val;
+    if (p[i].ran_param_id == id
+        && (v->type == ELEMENT_KEY_FLAG_TRUE_RAN_PARAMETER_VAL_TYPE || v->type == ELEMENT_KEY_FLAG_FALSE_RAN_PARAMETER_VAL_TYPE)) {
+      const ran_parameter_value_t* e = v->type == ELEMENT_KEY_FLAG_TRUE_RAN_PARAMETER_VAL_TYPE ? v->flag_true : v->flag_false;
+      if (e != NULL && e->type == INTEGER_RAN_PARAMETER_VALUE) {
+        *out = e->int_ran;
+        return true;
+      }
+    }
+    if (v->type == STRUCTURE_RAN_PARAMETER_VAL_TYPE && v->strct != NULL
+        && ccma_rc_find_int(v->strct->ran_param_struct, v->strct->sz_ran_param_struct, id, out, depth + 1))
+      return true;
+    if (v->type == LIST_RAN_PARAMETER_VAL_TYPE && v->lst != NULL)
+      for (size_t j = 0; j < v->lst->sz_lst_ran_param; j++)
+        if (ccma_rc_find_int(v->lst->lst_ran_param[j].ran_param_struct.ran_param_struct,
+                             v->lst->lst_ran_param[j].ran_param_struct.sz_ran_param_struct,
+                             id,
+                             out,
+                             depth + 1))
+          return true;
+  }
+  return false;
+}
+#endif
