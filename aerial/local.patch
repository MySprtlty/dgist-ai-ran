+    [ -n "${PRACH_FORCE_THR0:-}" ] && { in_c "grep -q CUPHY_PRACH_FORCE_THR0 $SDK/$BUILD_DIR/cuPHY-CP/cuphydriver/src/libcuphydriver.so" || echo "!! PRACH_FORCE_THR0 set but libcuphydriver.so lacks the CUPHY_PRACH_FORCE_THR0 change"; }
