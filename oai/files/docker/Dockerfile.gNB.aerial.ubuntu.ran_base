#---------------------------------------------------------------------
#
# Dockerfile for the Open-Air-Interface BUILD service
#   Valid for Ubuntu 24.04
#
#---------------------------------------------------------------------

FROM ran-base:latest AS ran-build

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade --yes && \
    DEBIAN_FRONTEND=noninteractive apt-get install --yes \
        wget \
        ninja-build \
        unzip \
        moreutils \
        vim-tiny \
        nano \
        cmake \
        libpcap-dev \
        libcunit1-dev \
        libnuma-dev \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

COPY nvipc_src.*.tar.gz /tmp/

RUN cd /tmp && \
    tar -xzf nvipc_src.*.tar.gz && \
    cd nvipc_src.* && \
    rm -rf build && \
    mkdir build && \
    cd build && \
    cmake .. \
        -DNVIPC_DPDK_ENABLE=OFF \
        -DNVIPC_DOCA_ENABLE=OFF \
        -DNVIPC_CUDA_ENABLE=OFF \
        -DENABLE_SLT_RSP=ON && \
    cmake --build . --parallel && \
    cmake --install . && \
    ldconfig && \
    rm -rf /tmp/nvipc_src.*

WORKDIR /oai-ran

