+  in_c "grep -E ' (WRN|ERR|FATAL) |Send Err.ind|recovery|not responsive|Order kernel timeout|exit handler|CONFIG.req received|START.req|L1 is ready|RACH|Preambles|dApp sizer' $PHYLOG" > $Dd/phy_warn.log 2>/dev/null
