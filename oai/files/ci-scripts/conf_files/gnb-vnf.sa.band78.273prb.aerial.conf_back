);

MACRLCs = (
{
  num_cc           = 1;
  remote_s_address = "127.0.0.1"; // pnf addr [!]
  local_s_address  = "127.0.0.2"; // vnf addr
  local_s_portc    = 50001; // vnf p5 port
  remote_s_portc   = 50000; // pnf p5 port [!]
