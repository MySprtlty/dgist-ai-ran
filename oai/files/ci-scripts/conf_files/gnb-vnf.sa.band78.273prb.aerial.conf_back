Active_gNBs = ( "gNB-OAI");
Asn1_verbosity = "none";
nfapi = "AERIAL";
gNBs =
(
 {
    ////////// Identification parameters:
    gNB_ID    =  0xe00;
    gNB_name  =  "gNB-OAI";

    // Tracking area code, 0x0000 and 0xfffe are reserved values
