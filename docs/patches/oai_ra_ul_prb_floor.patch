+/* ICNL 11/11: E2SM-RC Control Style 2 for the Resource Allocator xApp (see fill_rc_ctrl_style_2) */
+static void ccma_rc_style_2(rc_ctrl_req_data_t const* ctrl)
+{
+#ifndef NGRAN_GNB_DU
+  (void)ctrl;
+  LOG_W(NR_MAC, "RC CONTROL style 2: no MAC in this E2 node (no DU), ignored\n");
+#else
+  if (ctrl->hdr.frmt_1.ctrl_act_id != CCMA_RC_ACT_UL_LA) {
+    LOG_W(NR_MAC, "RC CONTROL style 2 action %u not supported, ignored\n", ctrl->hdr.frmt_1.ctrl_act_id);
+    return;
+  }
+  const seq_ran_param_t* rp = ctrl->msg.frmt_1.ran_param;
+  const size_t n = ctrl->msg.frmt_1.sz_ran_param;
+  int64_t rnti = 0, floor_prb = -1, validity = 0;
+  ccma_rc_find_int(rp, n, CCMA_RC_P_RNTI, &rnti, 0);
+  ccma_rc_find_int(rp, n, CCMA_RC_P_VALIDITY, &validity, 0);
+  if (!ccma_rc_find_int(rp, n, CCMA_RC_P_UL_FLOOR, &floor_prb, 0) || rnti <= 0 || rnti > 0xffff || floor_prb < 0
+      || validity < 0) {
+    LOG_W(NR_MAC,
+          "RC CONTROL style 2 action 101: needs C-RNTI and UL PRB floor (rnti %ld floor %ld validity %ld), ignored\n",
+          (long)rnti,
+          (long)floor_prb,
+          (long)validity);
+    return;
+  }
+  ccma_e2_set_ul_floor((uint16_t)rnti, (int)floor_prb, (int)validity);
+#endif
+}
