diff --git a/cuPHY-CP/dapp_hook/cots/install_nvidia.sh b/cuPHY-CP/dapp_hook/cots/install_nvidia.sh
new file mode 100755
index 0000000..a31efca
--- /dev/null
+++ b/cuPHY-CP/dapp_hook/cots/install_nvidia.sh
@@ -0,0 +1,8 @@
+#!/bin/bash
+# install_nvidia.sh [target]  - copy this package to the nvidia account (default /home/nvidia/dgist_cots) and hand it over (owner nvidia, scripts executable).
+# The package is self-contained on the host side (yamls, OAI compose + gnb.conf, core scripts); the L1 itself runs via 'docker exec' inside the Aerial
+# container, so the nvidia account needs only the docker group (it has it) and sudo for the core network scripts.
+set -eu; D=$(cd "$(dirname "$0")" && pwd); T=${1:-/home/nvidia/dgist_cots}
+sudo mkdir -p $T; sudo cp -a $D/. $T/; sudo rm -rf $T/runs; sudo mkdir -p $T/runs; sudo rm -f $T/runs/current_run
+sudo chown -R nvidia:nvidia $T; sudo chmod 755 $T $T/*.sh $T/core/*.sh; sudo chmod 775 $T/runs
+echo "installed in $T (owner nvidia): $(ls $T | tr '\n' ' ')"
diff --git a/cuPHY-CP/dapp_hook/cots/oai/docker-compose.yaml b/cuPHY-CP/dapp_hook/cots/oai/docker-compose.yaml
new file mode 100644
index 0000000..c0906a6
--- /dev/null
+++ b/cuPHY-CP/dapp_hook/cots/oai/docker-compose.yaml
@@ -0,0 +1,27 @@
+# OAI gNB only (the L1 is our cuphycontroller inside the Aerial container, host IPC namespace; nvIPC prefix 'nvipc' = the researchers' baseline).
+# Same as the researchers' sa_gnb_aerial compose minus the nv-cubb service: ipc host instead of 'container:nv-cubb', no GPU reservation,
+# cpuset off the L1/dApp cores. gnb.conf = their gnb_original.txt with tr_s_poll_core 62 (the only edit). Started/stopped by ../cots_run.sh.
+services:
+  oai-gnb:
+    container_name: ${OAI_CONTAINER:-oai-gnb-dgist}
+    image: ${OAI_IMAGE:-oai-gnb-aerial_hsw:hybrid-uci}
+    cpuset: "${OAI_CPUSET:-56-62}"
+    cap_drop:
+      - ALL
+    cap_add:
+      - SYS_NICE
+      - IPC_LOCK
+    ipc: host
+    network_mode: host
+    stdin_open: true
+    tty: true
+    environment:
+      USE_ADDITIONAL_OPTIONS: --log_config.global_log_options level,nocolor,utc_time
+    volumes:
+      - ./gnb.conf:/opt/oai-gnb/etc/gnb.conf
+      - /usr/local/lib/flexric:/usr/local/lib/flexric:ro
+    healthcheck:
+      test: /bin/bash -c "ps aux | grep -v grep | grep -c softmodem"
+      interval: 10s
+      timeout: 5s
+      retries: 5
