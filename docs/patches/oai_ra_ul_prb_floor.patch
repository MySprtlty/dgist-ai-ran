+/* ICNL 11/11 (IITP demo, Resource Allocator): UL PRB floor per slot and UE from the RA xApp (E2SM-RC Style 2 action 101
+ * parameter 5, ran_func_rc.c; ccma_e2.h). Written by the E2 agent thread, read by pf_ul under ra_floor_mtx.
+ * Semantics in pf_ul: the stock order and sizes stay (retransmissions first, then new transmissions greedy in PF order),
+ * but the floors of the UEs not served yet in this slot are kept out of the grants of the UEs before them (within the
+ * same service quota), and a floor UE's own grant is at least its reservation; above the floor the stock rules decide. */
+#define RA_FLOOR_UES 32
+static pthread_mutex_t ra_floor_mtx = PTHREAD_MUTEX_INITIALIZER;
+static struct {
+  uint16_t rnti; /* 0 = free entry */
+  int prb;
+  uint64_t until_us; /* 0 = until replaced */
+} ra_floor_tab[RA_FLOOR_UES];
+static volatile int ra_floor_any; /* fast path: no floor received yet */
+static uint64_t ra_floor_log_n;
+
+static uint64_t ra_now_us(void)
+{
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return (uint64_t)t.tv_sec * 1000000ULL + (uint64_t)t.tv_nsec / 1000;
+}
+
+int ccma_e2_set_ul_floor(uint16_t rnti, int floor_prb, int validity_ms)
+{
+  if (rnti == 0 || floor_prb < 0)
+    return -1;
+  const uint64_t until = validity_ms > 0 ? ra_now_us() + (uint64_t)validity_ms * 1000 : 0;
+  int ret = -1;
+  pthread_mutex_lock(&ra_floor_mtx);
+  int k = -1;
+  for (int i = 0; i < RA_FLOOR_UES; i++) {
+    if (ra_floor_tab[i].rnti == rnti) {
+      k = i;
+      break;
+    }
+    if (k < 0 && ra_floor_tab[i].rnti == 0)
+      k = i;
+  }
+  if (k >= 0) {
+    if (floor_prb == 0) {
+      memset(&ra_floor_tab[k], 0, sizeof(ra_floor_tab[k]));
+    } else {
+      ra_floor_tab[k].rnti = rnti;
+      ra_floor_tab[k].prb = min(floor_prb, NR_UL_PRB_TOTAL_BUDGET);
+      ra_floor_tab[k].until_us = until;
+      ra_floor_any = 1;
+    }
+    ret = 0;
+  }
+  pthread_mutex_unlock(&ra_floor_mtx);
+  if (ra_floor_log_n < 100 || ra_floor_log_n % 1000 == 0)
+    LOG_I(NR_MAC, "[RA_FLOOR] E2 ctrl #%lu: UE %04x UL floor %d PRB/slot, validity %d ms%s\n", (unsigned long)ra_floor_log_n, rnti,
+          floor_prb, validity_ms, ret < 0 ? " (table full, ignored)" : "");
+  ra_floor_log_n++;
+  return ret;
+}
+
+/* this UE's floor now (0 = none or expired) */
+static int ra_floor_get(uint16_t rnti)
+{
+  if (!ra_floor_any)
+    return 0;
+  const uint64_t now = ra_now_us();
+  int f = 0;
+  pthread_mutex_lock(&ra_floor_mtx);
+  for (int i = 0; i < RA_FLOOR_UES; i++) {
+    if (ra_floor_tab[i].rnti != rnti)
+      continue;
+    if (ra_floor_tab[i].until_us && now > ra_floor_tab[i].until_us)
+      memset(&ra_floor_tab[i], 0, sizeof(ra_floor_tab[i])); /* expired: back to the stock scheduler */
+    else
+      f = ra_floor_tab[i].prb;
+    break;
+  }
+  pthread_mutex_unlock(&ra_floor_mtx);
+  return f;
+}
