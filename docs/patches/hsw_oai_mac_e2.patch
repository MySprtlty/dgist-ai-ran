+/* Shared PUSCH RB-count budget
+ * per target UL slot (all connected UEs and beams), NOT a frequency window.
+ * RA/Msg3 has its own scheduler; existing PUSCHs, including Msg3, consume
+ * available headroom here, but that separate path is not capped by this code. */
+enum { UL_FIXED_TOTAL_PRB_CAP = NR_UL_PRB_TOTAL_BUDGET };
+
+static unsigned ul_fixed_used_prbs(const nfapi_nr_ul_tti_request_t *req)
+{
+  unsigned used = 0;
+  for (unsigned i = 0; i < req->n_pdus; i++)
+    if (req->pdus_list[i].pdu_type == NFAPI_NR_UL_CONFIG_PUSCH_PDU_TYPE)
+      used += req->pdus_list[i].pusch_pdu.rb_size;
+  return used;
+}
+
+/* Count already queued grants by RNTI, including retransmissions, across
+ * scheduler passes. Service accounting sums all current member RNTIs. */
+static unsigned ul_quota_used_prbs(const nfapi_nr_ul_tti_request_t *req, uint16_t rnti)
+{
+  unsigned used = 0;
+  for (unsigned i = 0; i < req->n_pdus; i++)
+    if (req->pdus_list[i].pdu_type == NFAPI_NR_UL_CONFIG_PUSCH_PDU_TYPE
+        && req->pdus_list[i].pusch_pdu.rnti == rnti)
+      used += req->pdus_list[i].pusch_pdu.rb_size;
+  return used;
+}
+
+static unsigned ul_service_used_prbs(const gNB_MAC_INST *mac,
+                                    const nfapi_nr_ul_tti_request_t *req, unsigned id)
+{
+  if (id < 1 || id > 2) return 0;
+  unsigned used = 0;
+  for (unsigned j = 0; mac->UE_info.connected_ue_list[j]; ++j) {
+    const NR_UE_info_t *member = mac->UE_info.connected_ue_list[j];
+    if (member->e2_ul_slice_id == id)
+      used += ul_quota_used_prbs(req, member->rnti);
+  }
+  return used;
+}
+
+/* First contiguous free run meeting the minimum; scan the entire BWP.
+ * Skipping a short occupied/fragmented prefix avoids fixing the allocation
+ * to [0, budget-1]. The returned length is capped by the remaining count. */
+static int ul_fixed_find_run(const uint16_t *mask, int bwp_start, int bwp_size,
+                             uint16_t symbols, int minimum, int budget, int *start)
+{
+  if (minimum <= 0 || budget < minimum)
+    return 0;
+  for (int rb = 0; rb < bwp_size;) {
+    while (rb < bwp_size && (mask[bwp_start + rb] & symbols))
+      rb++;
+    int first = rb;
+    while (rb < bwp_size && !(mask[bwp_start + rb] & symbols) && rb - first < budget)
+      rb++;
+    if (rb - first >= minimum) {
+      *start = first;
+      return rb - first;
+    }
+  }
+  return 0;
+}
+
+/* UL_SLICE_TRANSITION_BEGIN: caller holds sched_lock. */
+static bool ul_slice_needs_drain(const gNB_MAC_INST *mac, const NR_UE_info_t *ue)
+{
+  if (!mac->e2_ul_slice_pending)
+    return false;
+  for (unsigned j = 0; j < NR_UL_PRB_QUOTA_UES; j++) {
+    if (mac->e2_ul_slice_pending_rnti[j] != ue->rnti)
+      continue;
+    unsigned id = mac->e2_ul_slice_pending_id[j];
+    unsigned old_id = ue->e2_ul_slice_id;
+    unsigned old_quota = old_id >= 1 && old_id <= 2 && mac->e2_ul_slice_prbs[old_id - 1]
+                             ? mac->e2_ul_slice_prbs[old_id - 1] : NR_UL_PRB_TOTAL_BUDGET;
+    return id >= 1 && id <= 2 && (old_id != id || mac->e2_ul_slice_pending_prbs[id - 1] < old_quota);
+  }
+  return false;
+}
+
+static void ul_slice_try_transition(gNB_MAC_INST *mac)
+{
+  if (!mac->e2_ul_slice_pending)
+    return;
+  NR_UE_info_t *targets[NR_UL_PRB_QUOTA_UES] = {0};
+  unsigned n = 0;
+  UE_iterator(mac->UE_info.connected_ue_list, ue) {
+    n++;
+    for (unsigned j = 0; j < NR_UL_PRB_QUOTA_UES; j++)
+      if (ue->rnti == mac->e2_ul_slice_pending_rnti[j])
+        targets[j] = ue;
+  }
+  bool valid = n == NR_UL_PRB_QUOTA_UES;
+  for (unsigned j = 0; j < NR_UL_PRB_QUOTA_UES; j++)
+    valid &= targets[j] != NULL;
+  if (valid) {
+    bwp_info_t a = get_pusch_bwp_start_size(targets[0]);
+    for (unsigned j = 0; j < NR_UL_PRB_QUOTA_UES; j++) {
+      bwp_info_t b = get_pusch_bwp_start_size(targets[j]);
+      valid &= a.bwpSize >= NR_UL_PRB_TOTAL_BUDGET && a.bwpSize == b.bwpSize && a.bwpStart == b.bwpStart;
+    }
+  }
+  if (!valid) {
+    mac->e2_ul_slice_pending = false;
+    LOG_W(NR_MAC, "[E2_SLICE_CANCEL] pending transition cancelled: UE membership/BWP changed\n");
+    return;
+  }
+  for (unsigned j = 0; j < NR_UL_PRB_QUOTA_UES; j++) {
+    if (!ul_slice_needs_drain(mac, targets[j]))
+      continue;
+    for (unsigned h = 0; h < NR_MAX_HARQ_PROCESSES; h++) {
+      const NR_UE_ul_harq_t *harq = &targets[j]->UE_sched_ctrl.ul_harq_processes[h];
+      if (harq->is_waiting || harq->round > 0)
+        return; /* Old grants (including future PUSCH) still own this budget. */
+    }
+  }
+  memcpy(mac->e2_ul_slice_prbs, mac->e2_ul_slice_pending_prbs, sizeof(mac->e2_ul_slice_prbs));
+  for (unsigned j = 0; j < NR_UL_PRB_QUOTA_UES; j++)
+    targets[j]->e2_ul_slice_id = mac->e2_ul_slice_pending_id[j];
+  mac->e2_ul_slice_pending = false;
+  mac->e2_ul_slice_revision++;
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  uint64_t elapsed = (uint64_t)now.tv_sec * 1000000 + now.tv_nsec / 1000 - mac->e2_ul_slice_pending_since_us;
+  LOG_I(NR_MAC, "[E2_SLICE_TRANSITION_DONE] revision=%u s1_prbs=%u s2_prbs=%u drain_us=%llu\n",
+        mac->e2_ul_slice_revision, (unsigned)mac->e2_ul_slice_prbs[0],
+        (unsigned)mac->e2_ul_slice_prbs[1], (unsigned long long)elapsed);
+}
+/* UL_SLICE_TRANSITION_END */
+
+/* QUOTA_MAC_HELPERS: the pure count/search helpers above are tested separately. */
+static int ul_service_allowance(const gNB_MAC_INST *mac, const nfapi_nr_ul_tti_request_t *req,
+                                const NR_UE_info_t *ue, int global_remaining, bool retransmission)
+{
+  if (!retransmission && ul_slice_needs_drain(mac, ue))
+    return 0; /* Stop replenishing old HARQ while shrinking/remapping. */
+  if (retransmission && mac->e2_ul_slice_pending && ue->e2_ul_slice_id == 0)
+    return global_remaining; /* Pre-association grants used the shared total budget. */
+  if (!mac->e2_ul_slice_prbs[0] && !mac->e2_ul_slice_prbs[1])
+    return global_remaining;
+  unsigned id = ue->e2_ul_slice_id;
+  if (id < 1 || id > 2)
+    return 0; /* no borrowing through an unassociated/default service */
+  unsigned used = ul_service_used_prbs(mac, req, id);
+  unsigned quota = mac->e2_ul_slice_prbs[id - 1];
+  int remaining = used < quota ? quota - used : 0;
+  return min(global_remaining, remaining);
+}
+
+static void ul_log_quota_grant(gNB_MAC_INST *mac, const nfapi_nr_ul_tti_request_t *req,
+                                NR_UE_info_t *ue, int frame, int target_frame, int target_slot,
+                                unsigned rb_size, bool retransmission)
+{
+  unsigned id = ue->e2_ul_slice_id;
+  bool changed = ue->e2_ul_slice_applied_revision != mac->e2_ul_slice_revision;
+  if (changed || frame % 100 == 0) {
+    LOG_I(NR_MAC, "[UL_SERVICE_PRB] pusch=%d.%d revision=%u rnti=%04x service=%u quota=%u service_used=%u ue_used=%u grant=%u retx=%d total=%u cap=%u\n",
+          target_frame, target_slot, mac->e2_ul_slice_revision, ue->rnti, id,
+          id >= 1 && id <= 2 ? (unsigned)mac->e2_ul_slice_prbs[id - 1] : 0,
+          ul_service_used_prbs(mac, req, id), ul_quota_used_prbs(req, ue->rnti),
+          rb_size, retransmission, ul_fixed_used_prbs(req), (unsigned)NR_UL_PRB_TOTAL_BUDGET);
+    if (changed) {
+      LOG_I(NR_MAC, "[E2_SLICE_APPLIED] mode=count_no_lending revision=%u rnti=%04x service=%u quota=%u pusch=%d.%d\n",
+            mac->e2_ul_slice_revision, ue->rnti, id,
+            id >= 1 && id <= 2 ? (unsigned)mac->e2_ul_slice_prbs[id - 1] : 0, target_frame, target_slot);
+      ue->e2_ul_slice_applied_revision = mac->e2_ul_slice_revision;
+    }
+  }
+}
