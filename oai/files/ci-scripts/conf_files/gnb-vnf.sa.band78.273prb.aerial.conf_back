      nrofDownlinkSymbols                                           = 10; #6;
      nrofUplinkSlots                                               = 3;  #1;
      nrofUplinkSymbols                                             = 0;

      ssPBCH_BlockPower                                             = -15;
  }
  );
    SCTP :
    {
        # Number of streams to use in input/output
        SCTP_INSTREAMS  = 2;
        SCTP_OUTSTREAMS = 2;
    };


    ////////// AMF parameters:
    amf_ip_address = ({ ipv4 = "192.168.70.132"; });


    NETWORK_INTERFACES :
    {
