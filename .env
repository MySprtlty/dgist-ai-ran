# _dgist/.env - the one settings file: docker compose reads it, dgist.sh sources it, the L1 container gets every line via env_file.
# One VAR=value per line, comments on their own lines (both parsers accept this form).

# ---- images / build
AERIAL_IMAGE=nvcr.io/nvidia/aerial/aerial-cuda-accelerated-ran:25-3-cubb
OAI_IMAGE=dgist-oai-gnb-aerial:latest
# L1 build directory inside ./aerial-cuda-accelerated-ran (flags: SCF_FAPI_10_04 OFF, ENABLE_CONFORMANCE_TM_PDSCH_PDCCH OFF, SCF_FAPI_10_04_SRS ON, ENABLE_DAPP_HOOK ON)
BUILD_DIR=build.aarch64_f1002
# cuphycontroller_scf <L1_CONFIG> -> config/cuphycontroller_<L1_CONFIG>.yaml + config/l2_adapter_<L1_CONFIG>.yaml
L1_CONFIG=dgist
# cores for builds (the non-isolated housekeeping cores; 4-64 are isolcpus and carry the real-time threads)
BUILD_CPUS=0-3,65-71

# ---- OAI gNB container
# off the L1 cores (yaml: 4-11), the dApp cores (43, 45, 46) and the hsw stack's own cpuset (13-18); gnb.conf tr_s_poll_core = 62
OAI_CPUSET=56-62

# ---- L1 / dApp (defaults = the configuration validated with the COTS UE on 2026-10-30 and the 1-cell package on 2026-11-05)
# PRACH detection threshold the hsw binary hard-codes; our cuphydriver reads it from the environment. Empty = cuPHY's own threshold
PRACH_FORCE_THR0=20.0
# per-slot PUSCH / PDSCH green-context profiles the sizer may choose (the largest replaces the yaml mps_sm_* value)
DAPP_PUSCH_PROFILES=16,24,32,40,56
DAPP_PDSCH_PROFILES=24,40
# YOLO partition classes = free-SM values of the 1-cell layout (P-N-8); one TensorRT engine per model x class
DAPP_TENANT_CLASSES=24,40,48,56,64,72,80
# YOLO input profile the tenant's engines were built for (2026-11-09): 4k = 3840x2160, batch-8 1280 tiles (6 native crops + 2 whole-image views), models/full26<m>
#   fhd = 1920x1080, batch-3 (2 native 1280x1080 crops + 1 whole-image view), models/fhd26<m> - built by scripts/build_yolo_engines.sh fhd
#   VA_CAMERA_WIDTH/HEIGHT should match (dgist.sh check notes a mismatch); a frame of another size still runs, with whole-image views only
DAPP_INPUT=fhd
# SM classes used with DAPP_INPUT=fhd (same ladder as 4K since 2026-11-10 11:00). Two TensorRT 10.3 issues had cost class 80 on 11-10 morning:
#   (1) the tenant deserialized each class's engines in its own green context, and Myelin sizes its GEMM grids from the context current at that
#       moment and caches them per kernel for the process -> the first class loaded dictated the grids of the others (fixed: every engine is now
#       deserialized in the primary context, DAPP_TENANT_ENGINE_CTX=prim default); (2) the fhd26s/fhd26l sm80 engines with the native sm80 tactics
#       fail "Cask Gemm execution" next to another class of the same model -> they are built with the sm72 timing cache (scripts/build_yolo_engines.sh).
DAPP_TENANT_CLASSES_FHD=24,40,48,56,64,72,80,88
DAPP_TENANT_CPU=45
DAPP_AGENT_CPU=46
# xApp interface (TCP, JSON lines; docs: aerial-cuda-accelerated-ran/cuPHY-CP/dapp_hook/docs/XAPP_INTERFACE.md)
DAPP_AGENT_PORT=9810
DAPP_AGENT_GRAPH_CHUNK=3
DAPP_AGENT_CHUNK_AHEAD=2
DAPP_AGENT_QOS=1
# 1 = the L1 tenant writes one CSV line per slot (RAN-reserved SMs, SMs the running YOLO inference holds, queue, wall clock) into
#     runs/<name>/dapp_tenant_slots.csv (~5 MB/min). ./dgist.sh slotmap <name> renders it into the GPU slot-map video (Baseline lane computed with the 72/60 MIG wall).
DAPP_SLOT_CSV=1
# sizer YOLO term (2026-11-14): extra PUSCH planning margin in us per slot-in-frame ("slot:us,..."), used only while a YOLO request is in hand
#   (the L1's PUSCH finishes later when a YOLO inference runs next to it on the other SMs). Empty = off = the plan without the term. Ours mode only.
#   L1 log: "dApp sizer YOLO term: ..."; counters at the end of the sizer line in runs/<name>/dapp_tenant.log. Hold time: DAPP_SIZER_YOLO_HOLD_MS (default 1000).
DAPP_SIZER_YOLO_US=7:120,8:120,17:120,18:120

# ---- VA service (va.sh): the hsw yolo_service with the inference forwarded to the dApp agent - va_service/README.md
# dapp = every phone frame becomes a RUN (model, QoS, JPEG) to the agent inside the L1 process | local = the hsw original (ultralytics here)
VA_BACKEND=dapp
# the model of every request (26n 26s 26m 26l 26x) while VA_MODEL_SELECT=0
VA_MODEL=26x
# rule-based model selection (va_service/model_select.py): 0 = off, every request uses VA_MODEL | 1 = on, the model of each request follows VA_MODEL_WEIGHTS
VA_MODEL_SELECT=1
# requests per block for 26n,26s,26m,26l,26x (this order). A block = their sum (here 100 requests): exactly 10 run 26n, 10 26s, 60 26m, 10 26l and 10 26x,
# and which request gets which model is random (0 = that model never runs). A model the YOLO server has not loaded (Baseline: models without a MIG engine)
# is sent as VA_MODEL. Apply: ./va.sh restart (Baseline: ./dgist.sh down + up as well). Check: ./va.sh status. Optional VA_MODEL_SEED=<int> repeats the same order.
VA_MODEL_WEIGHTS=10,10,60,10,10
# QoS: RUN qos.deadline_ms (the agent refuses a request it cannot finish in time) and the per-frame E2E target the phone judges
VA_DEADLINE_MS=200
# phone capture: requests per second per UE, resolution, JPEG quality, unanswered frames tolerated before a capture is skipped
VA_TARGET_FPS=15
VA_CAMERA_WIDTH=1920
VA_CAMERA_HEIGHT=1080
VA_JPEG_QUALITY=0.90
VA_MAX_INFLIGHT=4
# phone-page boxes (2026-11-11): VA_TRACK=1 keeps one box per object across results (same-class IoU matching, smoothing, velocity
#   prediction over the latency, fade-out after VA_TRACK_TTL_MS without a fresh detection); VA_QOS_DROP_MISSED=1 does not draw a result
#   whose E2E missed VA_DEADLINE_MS (its boxes coast, then fade); VA_DISPLAY_CONF = lowest confidence drawn (the dApp reports down to 0.25)
VA_TRACK=1
VA_QOS_DROP_MISSED=1
VA_DISPLAY_CONF=0.40
VA_TRACK_TTL_MS=700
# phone-page JPEG encoding (2026-11-11): N Web Workers encode frames in parallel (OffscreenCanvas); the main thread only grabs the frame.
#   A phone whose encode takes 60-90 ms is capped at 11-16 fps on the main thread; 2 workers lift that to ~20 fps (uplink permitting). 0 = original path.
VA_ENCODE_WORKERS=2
# phone-page video-file source (2026-11-12): "Video File" plays a video stored on the phone instead of the camera (read locally, no downlink);
#   every frame of the file is converted to this size (aspect kept, black bars) before the JPEG. The camera mode still sends the camera's native frame.
VA_FILE_WIDTH=1920
VA_FILE_HEIGHT=1080
# HTTPS port the UE connects to (https://10.45.0.1:VA_PORT/) and the dApp agent address (L1 container, network host)
VA_PORT=8000
VA_AGENT=127.0.0.1:9810
# 1 = one console line per frame in runs/va_service/uvicorn.log
VA_VERBOSE=0

# ---- non-VA service (nonva.sh): the hsw video_stream_service as is - the other phone uploads 720p frames, the server relays them to
# https://10.45.0.1:8001/viewer/<ue>; UL latency CSV; telemetry 'nonva' for the hsw PPO xApp. No inference. Defaults = hsw values.
NONVA_PORT=8001
NONVA_WIDTH=1280
NONVA_HEIGHT=720
NONVA_FPS=15
NONVA_JPEG_QUALITY=0.65
NONVA_VIEWER_FPS=15

# ---- FlexRIC (nearRT-RIC + xApps built from ./openairinterface5g/openair2/E2AP/flexric; ric.sh / xapp.sh)
FLEXRIC_BUILD=build_dgist
# service-model libraries of that build; the gNB container mounts this directory as /usr/local/lib/flexric (gNB restart to switch)
FLEXRIC_SM_DIR=/home/nvidia/_dgist/flexric_sm
# our RIC listens on 127.0.0.2 (config/flexric.conf, flexric_xapp.conf, gnb.conf e2_agent): the lab's leftover xApps keep polling 127.0.0.1
RIC_IP=127.0.0.2

# ---- PPO slicing xApp (xapp.sh): hsw GPU-aware PPO (xapp_ppo/) + the DGIST dApp feed
# bundle: xapp_gpu_aware_no_lending_6G = 20-input policy (radio 18 + YOLO model + SMs from our dApp via the compute file, hsw 2026-11-05)
#         xapp_gpu_aware_no_lending    = 19-input policy (radio 18 + NVML GPU utilization)
PPO_BUNDLE_NAME=xapp_gpu_aware_no_lending_6G
# which phone (SIM IMSI) belongs to which service - stable across re-attach; xapp.sh maps them to the current RNTIs (ue_table.py)
VA_IMSIS=999700000177992,999700000177998
NONVA_IMSIS=999700000177994,999700000177996
# 1 = xapp.sh start also runs a guard that restarts the xApp with the new RNTIs when a phone re-attaches (check every XAPP_GUARD_S s)
XAPP_GUARD=1
XAPP_GUARD_S=5
# 19th actor input: nvml = host GPU utilization (what the model was trained with) | dapp = GPU busy share seen by the L1 (YOLO+RAN SMs / 132), experimental
PPO_GPU_SOURCE=nvml
# 1 = connect to the dApp agent (role slicing) and record the last YOLO model / SMs with every decision
PPO_DAPP=1
PPO_MIN_PRBS=5
PPO_GPU_DEVICE=0

# ---- RU / core network
RU_IP=10.10.0.100
FH_IF=aerial00
UE_SUBNET=10.45.0.0/16
# 1 = do not require Open5GS on this host at 'up' (another host runs the core; gnb.conf amf_ip_address must point there)
NO_CORE=0

# ---- demo mode (2026-11-12) -------------------------------------------------------------------------------------------
#   ours     = our L1 (CUDA green contexts, FAPI-aware YOLO tenant, xApp agent) on the whole GPU               (default)
#   baseline = the researchers' vanilla cuBB 25-3 (BASELINE_TREE, config_benetal, MPS) on the MIG 4g instance (72 SMs)
#              + a naive YOLO server (batch-3 FHD engine of VA_MODEL, 60 SMs, no QoS / chunking; VA_MODEL_SELECT=1 adds the other models that have an engine) on the MIG 3g
#              instance, no slicing xApp. VA / non-VA services, settings, logs and the viewer are identical in both modes.
#   switch: ./all.sh mode baseline|ours (stack down; the MIG partition needs root: sudo -n scripts/mig.sh on|off);
#   the Baseline engine: scripts/build_yolo_engines_mig.sh x (built inside the 3g instance once)
DEMO_MODE=ours
# the researchers' own build (pristine 25-3 + their hard-coded PRACH threshold 20 and the Benetel timing values; the pristine 25_3 tree floods the gNB with false RAs)
BASELINE_TREE=/home/nvidia/hsw/25_3_hsw/aerial-cuda-accelerated-ran
BASELINE_L1_CONFIG=baseline
BASELINE_YOLO_SM=auto

# ---- 5-cell traffic generator (2026-11-13, both modes): RU emulator + testMAC as L1 cells 0-4 in the same L1; the phones' cell becomes L1 cell 5 ----
# on/off: ./tgen.sh on|off, then ./all.sh down + up (the L1 starts with 6 cells or with 1; the phones re-attach).
# load level WHILE RUNNING (no restart): ./tgen.sh load low|mid|high|auto   (PUSCH UEs per emulator cell and UL slot: low 1, mid 2, high 4; auto = 1,2,4,3 in turn, 3 s each)
TRAFFIC_GEN=1
TRAFFIC_LOAD=low
TRAFFIC_GEN_TV_DIR=/data/dgist_tgen/testVectors
TRAFFIC_GEN_LOG_DIR=/data/dgist_tgen/log
