+  docker logs -f $OAI_CONTAINER > $RUN/oai.log 2>&1 & OL=$!
+  sleep 5; grep -q 'NGSetupResponse' $RUN/oai.log && echo "   NG Setup with the AMF ok" || echo "   note: no NGSetupResponse yet (core network? watch $RUN/oai.log)"
